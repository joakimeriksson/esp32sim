+
+/// EX150 tracking-tax probe: pure overhead, never changes guest state. Core 0 plays the leader
+/// (stamps a read or write map with the window generation), core 1 the follower (loads the
+/// leader's map(s), compares with a generation that never matches, would-be conflict exit).
+/// Stores on both cores append (host address, old value) to an undo log.
+#[repr(C, align(1048576))]
+pub struct SpecArea { log: [u8; 1 << 20], pad: [u8; 64], gen: [u32; 2], logp: u32, pad2: u32, r: [u32; 1 << 20], w: [u32; 1 << 20] }
+pub static mut SPEC: SpecArea = SpecArea { log: [0; 1 << 20], pad: [0; 64], gen: [0; 2], logp: 0, pad2: 0, r: [0; 1 << 20], w: [0; 1 << 20] };
+pub static SPEC_ROLE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+pub static SPEC_MODE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(3); // bit0 marks/checks, bit1 undo log
+
+#[allow(static_mut_refs)]
+fn spec_tax(g: &mut Gen, width: u32, store: bool) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let mode = SPEC_MODE.load(Relaxed);
+    if mode == 0 { return; }
+    let base = &raw mut SPEC as usize as u32;
+    // SAFETY: single-threaded wasm; generated code only ever sees these after this initialization.
+    unsafe { if SPEC.logp == 0 { SPEC.logp = base; SPEC.gen = [1, u32::MAX]; } }
+    let (gen, logp, r, w) = unsafe { (&raw const SPEC.gen as usize, &raw const SPEC.logp as usize, &raw const SPEC.r as usize as u32, &raw const SPEC.w as usize as u32) };
+    let follower = SPEC_ROLE.load(Relaxed) == 1;
+    if mode & 1 != 0 {
+        g.get(ADDR); g.c(6); g.op(0x76); g.c((1 << 20) - 1); g.op(0x71); g.c(2); g.op(0x74); g.set(SPEC_A);
+        if !follower {
+            g.get(SPEC_A); g.c(if store { w } else { r }); g.op(0x6a);
+            g.c(0); g.load(gen);
+            g.store(0);
+        } else {
+            g.get(SPEC_A); g.c(w); g.op(0x6a); g.load(0);
+            g.c(0); g.load(gen + 4);
+            g.op(0x46);
+            if store {
+                g.get(SPEC_A); g.c(r); g.op(0x6a); g.load(0);
+                g.c(0); g.load(gen + 4);
+                g.op(0x46);
+                g.op(0x72);
+            }
+            g.bytes.extend([0x0d, 0]);
+        }
+    }
+    if store && mode & 2 != 0 {
+        g.c(0); g.load(logp); g.set(SPEC_A);
+        g.get(TLB); g.load(offset_of!(TlbEntry, base)); g.get(REL); g.op(0x6a); g.set(SPEC_B);
+        g.get(SPEC_A); g.get(SPEC_B); g.store(0);
+        g.get(SPEC_A); g.get(SPEC_B);
+        if width == 16 {
+            g.bytes.extend([0xfd, 0x00, 0, 0]);
+            g.bytes.extend([0xfd, 0x0b, 0, 8]);
+        } else {
+            g.op(match width { 1 => 0x2d, 2 => 0x2f, _ => 0x28 }); g.bytes.extend([0, 0]);
+            g.store(4);
+        }
+        g.c(0); g.get(SPEC_A); g.c(if width == 16 { 24 } else { 8 }); g.op(0x6a); g.c((1 << 20) - 1); g.op(0x71); g.c(base); g.op(0x72); g.store(logp);
+    }
 }
 
