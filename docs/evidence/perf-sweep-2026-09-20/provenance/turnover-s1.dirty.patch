+/// EX152: consecutive blocks in one call. The caller guarantees no stub, probe or observer;
+/// every other between-block machine check is covered by the exits below.
+pub fn run_blocks<B: Bus>(cpu: &mut Cpu, bus: &mut B, budget: u32) -> (u32, Option<Trap>, u32) {
+    let mut total = 0;
+    loop {
+        let pc = cpu.pc;
+        let (used, trap) = run_block(cpu, bus, budget - total);
+        total += used;
+        if trap.is_some() || total >= budget || used == 0 || cpu.waiting || bus.run_break() { return (total, trap, pc); }
+    }
+}
