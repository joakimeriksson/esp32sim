+/// EX164: direct call and windowed return edges inside one region. A driver calls a recursive
+/// function, so one region holds a call edge to a fresh chunk, a call edge back to its own
+/// ENTRY head, two static return sites and three returns. Every case runs against
+/// instruction-by-instruction interpretation under the same credit, probes, timer deadlines and
+/// code writes as every other region program.
+fn call_edges() -> u32 {
+    use Op::*;
