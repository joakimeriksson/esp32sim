+/// Version-page indices of a chunk's instruction bytes, appended to `into`.
+fn chunk_pages<B: Bus>(bus: &mut B, c: &Chunk, into: &mut Vec<u32>) {
+    let mut pc = c.pc;
+    for bi in &c.instructions {
+        let end = pc.wrapping_add(bi.insn.len as u32);
+        for a in [pc, end - 1] {
+            let p = bus.code_page(a);
+            if !into.contains(&p) { into.push(p); }
+        }
+        pc = end;
+    }
+}
