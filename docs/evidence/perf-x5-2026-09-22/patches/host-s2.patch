+    p.extend(asm::mov_n(10, 4));                        // 5  pass the pointer as the callee's a2
+    p.extend(asm::call8(BASE + 7, BASE + 16));          // 7  call8 F
+    p.extend(asm::j(BASE + 10, BASE));                  // 10 <- return site of the driver's call
+    p.resize(16, 0);                                    // 13 never decoded: no edge reaches it
+    p.extend(asm::entry(1, 32));                        // 16 F: entry a1, 32
+    p.extend(asm::l8ui(3, 2, 0));                       // 19 a3 = [a2]
+    p.extend(asm::bz(0, BASE + 22, 3, BASE + 39));      // 22 beqz a3, 39
