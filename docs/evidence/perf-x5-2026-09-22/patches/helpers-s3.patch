+/// helpers-s1/s3: the compiled RSIL and WSR/XSR terminals. Sweeps every register `write_sr` masks
+/// differently, the old value returned in AR[t], and the registers that must keep the helper.
+pub(super) fn sr_terminals() -> u32 {
+    use crate::state::sr;
+    use Op::*;
+    let mut tests = 0;
+    for (number, inline) in [(sr::PS, true), (sr::SCOMPARE1, true), (sr::INTENABLE, true),
+        (sr::CPENABLE, true), (sr::VECBASE, true), (sr::EXCCAUSE, true), (sr::EXCVADDR, true),
+        (sr::DEPC, true), (177, true), (183, true), (194, true), (199, true), (209, true),
+        (215, true), (244, true), (247, true),
+        (sr::PRID, false), (sr::WINDOWBASE, false), (sr::WINDOWSTART, false), (sr::LCOUNT, false),
+        (sr::SAR, false), (sr::CCOMPARE0, false)] {
+        for op in [Wsr, Xsr] {
+            let mut block = [insn(Add), insn(MovN), insn(op)];
+            block[2].insn.imm = number as i32;
+            // Falling back to the helper would pass the oracle silently.
+            assert_eq!(emitter::supported_insn(&block[2].insn, false), inline, "{op:?}({number})");
+            for (ps0, value) in [(0u32, 0xffff_ffffu32), (0x1f, 9), (ps::WOE | 3, 0x0007_ff3f)] {
+                tests += sr_sweep(&mut block, ps0, value);
+            }
+        }
+    }
+    for level in [0, 3, 15] {
+        let mut block = [insn(Add), insn(MovN), insn(Rsil)];
+        block[2].insn.imm = level;
+        assert!(emitter::supported_insn(&block[2].insn, false));
+        for (ps0, value) in [(0u32, 0u32), (0x1f, 9), (ps::WOE | 3, 0xffff_ffff)] {
+            tests += sr_sweep(&mut block, ps0, value);
+        }
+    }
+    tests
+}
