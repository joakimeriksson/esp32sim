+/// Entry, budget and hardware-loop coverage of one three-instruction block ending in a terminal:
+/// `lend` on the terminal's own fall-through makes the backedge come out of generated code.
+fn sr_sweep(block: &mut [BlockInsn], ps0: u32, value: u32) -> u32 {
+    let mut tests = 0;
+    for lend in [0, BASE + 6, BASE + 9] {
+        for entry in 0..3 {
+            for budget in [1, 3] {
+                let configure = |c: &mut Cpu| {
+                    c.ps = ps0;
+                    c.set_ar(4, value);
+                    c.set_ar(5, value);
+                    c.lbeg = BASE;
+                    c.lend = lend;
+                    c.lcount = 2 * u32::from(lend != 0);
+                };
+                let case = Case { seed: 15, entry, budget, ..Case::default() };
+                compare_hinted(block, case, &configure, lend);
+                compare_hinted(block, case, &configure, 0);
+                tests += 2;
+            }
+        }
+    }
+    tests
+}
