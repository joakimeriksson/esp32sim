+                        for lend in [0, BASE + 9] {
+                            for entry in 0..3 {
+                                for budget in [1, 3] {
+                                    let configure = |c: &mut Cpu| {
+                                        c.ps = flags;
+                                        c.windowbase = wb;
+                                        c.windowstart = windows;
