@@ -95,5 +95,106 @@ pub(super) fn run_tests() -> u32 {
             }
         }
     }
-    tests
+    tests + held_runs()
+}
+
+/// Decode `program` into a block ending in a NOP, as the block decoder would.
+fn block_of(program: &[Vec<u8>]) -> Vec<BlockInsn> {
+    let mut block = Vec::new();
+    let mut pc = BASE;
+    for encoded in program {
+        let mut bytes = [0; 4];
+        bytes[..encoded.len()].copy_from_slice(encoded);
+        let decoded = crate::decode::decode(pc, bytes);
+        assert_eq!(decoded.op, Op::Pie);
+        block.push(BlockInsn {
+            insn: decoded, max_ar: crate::exec::max_ar(&decoded), straddle: false, off: block.len() as u32,
+        });
+        pc = pc.wrapping_add(decoded.len as u32);
+    }
+    block.push(insn(Op::Nop));
+    block
+}
+
+/// EX184: a run of accumulates that no `ee.zero.accx` dominates. The emitter loads ACCX into
+/// its local at the first one and saturates there, so every cut position, both saturation
+/// edges and a first accumulate that never executes must leave exactly the architectural
+/// state the table executor leaves, unused `accx[1]` bits included.
+fn held_runs() -> u32 {
+    use crate::pie::Role::{As, Imm, Qu, Qx, Qy};
+    let mut block = block_of(&[
+        asm::pie("ee.vmulas.s8.accx", &[(Qx, 0), (Qy, 1)]),
+        asm::pie("ee.vmulas.s16.accx", &[(Qx, 0), (Qy, 1)]),
+        asm::pie("ee.vmulas.s8.accx.ld.ip", &[(Qx, 0), (Qy, 1), (Qu, 2), (As, 4), (Imm, 16)]),
+        asm::pie("ee.vmulas.s16.accx", &[(Qx, 2), (Qy, 1)]),
+    ]);
+    let mut cc = CodeCache::new(0).unwrap();
+    let code = compile(&mut cc, &mut block, BASE, true).expect("the accumulate run must compile");
+    for _ in 0..HOT { ready(&cc, code, 0); }
+    assert!(ready(&cc, code, 0));
+
+    let (high, low) = ((1i64 << 39) - 1, -(1i64 << 39));
+    let mut tests = 0;
+    for (name, initial) in [("high", high), ("low", low), ("near-high", high - 300_000), ("near-low", low + 300_000), ("zero", 0)] {
+        for (lanes, other) in [(0x80u8, 0x80u8), (0x80, 0x7f), (0x7f, 0x7f)] {
+            // Every budget: below the block length the checked body runs, which keeps ACCX
+            // in memory, and at the block length the whole body holds it in the local.
+            for budget in 1..=block.len() as u32 {
+                let context = format!("run {name} lanes={lanes:#x},{other:#x} budget={budget}");
+                CONTEXT.with(|c| *c.borrow_mut() = context.clone());
+                let (mut reference, mut actual) = (cpu(0), cpu(0));
+                for c in [&mut reference, &mut actual] {
+                    c.cpenable = 1 << 3;
+                    c.qr[0] = u128::from_le_bytes([lanes; 16]);
+                    c.qr[1] = u128::from_le_bytes([other; 16]);
+                    c.qr[2] = u128::from_le_bytes([lanes; 16]);
+                    c.accx = [initial as u32, ((initial >> 32) & 0xff) as u32 | 0xa5a5_a500];
+                    c.set_ar(4, BASE + 0x1000);
+                }
+                let (mut reference_ram, mut actual_ram) = (Ram::new(true, false), Ram::new(true, false));
+                let fm = actual_ram.fast_mem();
+                // SAFETY: code is ready, entry zero is valid and both helpers and mapping
+                // belong to the exclusively borrowed test bus.
+                let result = unsafe {
+                    run(&cc, code, &mut actual, &mut actual_ram, &Helpers::new::<Ram>(), budget, 0, fm)
+                };
+                assert_eq!(result & 0xffff, budget, "{context}");
+                assert!(actual.jit_trap.is_none(), "{context}");
+                for bi in block.iter().take(budget as usize) {
+                    let mut instruction = bi.insn;
+                    // Clear the packed marker: use the independent table executor.
+                    if instruction.op == Op::Pie { instruction.r = 0; }
+                    exec_insn(&mut reference, &mut reference_ram, &instruction).unwrap();
+                }
+                same(&reference, &actual);
+                tests += 1;
+            }
+        }
+    }
+
+    // A first accumulate whose slow access is deferred does not execute at all: the local
+    // has been loaded but not modified, so nothing may be written back over ACCX.
+    let mut block = block_of(&[
+        asm::pie("ee.vmulas.s8.accx.ld.ip", &[(Qx, 0), (Qy, 1), (Qu, 2), (As, 4), (Imm, 16)]),
+        asm::pie("ee.vmulas.s8.accx", &[(Qx, 0), (Qy, 1)]),
+    ]);
+    let code = compile(&mut cc, &mut block, BASE, true).expect("the deferred run must compile");
+    for _ in 0..HOT { ready(&cc, code, 0); }
+    let before = [0x1234_5678, 0xa5a5_a512];
+    let mut actual = cpu(0);
+    actual.cpenable = 1 << 3;
+    actual.accx = before;
+    actual.set_ar(4, SLOW);
+    let mut ram = Ram::new(true, false);
+    ram.defer_armed = true;
+    let fm = ram.fast_mem();
+    CONTEXT.with(|c| *c.borrow_mut() = "deferred first accumulate".into());
+    // SAFETY: as above.
+    let result = unsafe { run(&cc, code, &mut actual, &mut ram, &Helpers::new::<Ram>(), 3, 0, fm) };
+    // EX133's convention: the refused instruction is counted here and uncounted by the caller.
+    assert_eq!((result & 0xffff, (result >> 16) & 7), (1, crate::jit::CODE_TRAP), "deferred exit");
+    assert!(ram.deferred && actual.jit_trap.is_none());
+    assert_eq!(actual.accx, before, "deferred accumulate leaves ACCX alone");
+    assert_eq!(actual.pc, BASE);
+    tests + 1
 }
