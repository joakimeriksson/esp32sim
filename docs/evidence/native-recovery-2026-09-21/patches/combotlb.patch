diff --git a/xtensa-lx7/src/jit/mod.rs b/xtensa-lx7/src/jit/mod.rs
index 493e287e..6f193337 100644
--- a/xtensa-lx7/src/jit/mod.rs
+++ b/xtensa-lx7/src/jit/mod.rs
@@ -279,9 +279,9 @@ mod native {
             self.a.add_x_lsl(9, TLB, 9, TLB_ENTRY_SHIFT);
             self.a.ldr(10, 9, TLB_LO); self.a.ldr(11, 9, TLB_HI);
             self.a.cmp(addr, 10); self.a.b_cond(Cond::Lo, slow);
-            self.a.cmp(addr, 11); self.a.b_cond(Cond::Hs, slow);
-            // Subtract only after ordering the endpoints: addr + size could wrap at 4 GiB.
-            self.a.sub(13, 11, addr); self.a.cmp_imm(13, size); self.a.b_cond(Cond::Lo, slow);
+            // W-register address arithmetic and the LDR W11 above zero-extend both
+            // endpoints. The X-register sum cannot wrap at 4 GiB, including EMPTY entries.
+            self.a.add_imm_x(13, addr, size); self.a.cmp_x(13, 11); self.a.b_cond(Cond::Hi, slow);
             self.a.sub(10, addr, 10);                                             // offset
             self.a.ldr_x(12, 9, TLB_BASE);
         }
