diff --git a/esp32s3/tests/web_cadence.rs b/esp32s3/tests/web_cadence.rs
new file mode 100644
index 00000000..b1879009
--- /dev/null
+++ b/esp32s3/tests/web_cadence.rs
@@ -0,0 +1,70 @@
+//! Web publication cadence follows the board installed at each scheduler entry.
+use esp_soc::{board::BoardModel, web::WebServer, RunUntil, Stop};
+
+struct Board(u64);
+
+impl BoardModel for Board {
+    fn name(&self) -> &'static str { "cadence-test" }
+    fn display_push_hz(&self) -> u64 { self.0 }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Entry { Run, UntilCycle, ExternalQuantum }
+
+impl Entry {
+    fn advance(self, m: &mut esp32s3::Machine) {
+        let target = m.bus.cycles + m.quantum;
+        match self {
+            Self::Run => {
+                m.cores[0].waiting = true;
+                assert!(matches!(m.run(m.quantum), Stop::MaxInsns));
+            }
+            Self::UntilCycle => {
+                m.cores[0].waiting = true;
+                assert!(matches!(m.run_until_cycle(target), RunUntil::Reached));
+            }
+            Self::ExternalQuantum => {
+                m.cores[0].waiting = false;
+                assert_eq!(m.browser_external_block_budget(1), Some(m.quantum as u32));
+                assert!(m.finish_browser_external_quantum().is_none());
+            }
+        }
+        assert_eq!(m.bus.cycles, target, "{self:?}");
+    }
+}
+
+fn stat_count(web: &WebServer) -> usize {
+    web.take_outbox().into_iter().filter(|(kind, data)| {
+        *kind == 1 && data.starts_with(b"{\"t\":\"stat\",")
+    }).count()
+}
+
+#[test]
+fn board_replacement_preserves_last_push_and_refreshes_each_scheduler_entry() {
+    let entries = [Entry::Run, Entry::UntilCycle, Entry::ExternalQuantum];
+    for start in 0..entries.len() {
+        let mut m = esp32s3::machine([1, 2, 3, 4, 5, 6]);
+        m.console.capture = true;
+        m.cores[0].ps = 0;
+        let web = WebServer::queued();
+        m.web = Some(web.clone());
+        let mut last_push = 0;
+
+        // Choose the first board after construction, then replace it between calls.
+        // Rotate entry paths so every path sees both rates and a nonzero last push.
+        for (step, hz) in [120, 50, 120, 50].into_iter().enumerate() {
+            m.bus.board = Box::new(Board(hz));
+            let entry = entries[(start + step) % entries.len()];
+            let due = last_push + 240_000_000 / hz;
+            assert_eq!(due % m.quantum, 0);
+            // Skip uneventful emulated time, keeping the two boundary quanta real.
+            m.bus.cycles = due - 2 * m.quantum;
+            entry.advance(&mut m);
+            assert_eq!(stat_count(&web), 0, "{entry:?}: {hz} Hz published early");
+            entry.advance(&mut m);
+            assert_eq!(m.bus.cycles, due);
+            assert_eq!(stat_count(&web), 1, "{entry:?}: {hz} Hz missed its deadline");
+            last_push = due;
+        }
+    }
+}
